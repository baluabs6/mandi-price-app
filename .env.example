# Copy to .env and fill in for local docker-compose runs
DATA_GOV_IN_API_KEY=
SECRET_KEY=change-me
POSTGRES_DB=mandi_db
POSTGRES_USER=mandi_user
POSTGRES_PASSWORD=mandi_pass

# AI assistant (/api/ask) — get a key at https://console.anthropic.com/
# If left blank, the assistant endpoint still works but returns a plain
# "latest record" fallback instead of an LLM-generated answer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
